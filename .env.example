TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
PORT=3000

# ИИ-консультант (OpenAI Responses API).
# Пока AI_API_KEY пуст — чат отвечает по заготовкам,
# а сложные вопросы сразу передаёт менеджеру.
AI_API_URL=https://nodule-provider.store/v1/responses
AI_API_KEY=
AI_MODEL=gpt-5.4-mini
