# Настройки бекенда (backend/, служба atmosfera).
# На сервере живут в /etc/atmosfera/atmosfera.env с правами 600, владелец root.
# Сюда — только имена и примеры, настоящие значения в репозиторий не кладём.

# ── Обязательные: без них служба не запустится ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Хеш пароля админки. Получить: node tools/admin-password.js "пароль"
ADMIN_SALT=
ADMIN_HASH=
ADMIN_ITER=200000

# ── ИИ-консультант (OpenAI Responses API или совместимый) ──
# Пока AI_API_KEY пуст, чат отвечает заготовками, а сложные вопросы
# сразу передаёт менеджеру.
AI_API_URL=https://api.example.com/v1/responses
AI_API_KEY=
AI_MODEL=
# Дешёвая модель для простых вопросов; пусто — всё идёт в AI_MODEL
AI_MODEL_LIGHT=
# Сколько секунд ждать лёгкую модель, прежде чем спросить основную
AI_LIGHT_TIMEOUT=10
# Потолок вопросов консультанту в час со всего сайта — защита баланса
AI_LIMIT_HOUR=300

# ── GigaChat (если заполнен, консультант работает на нём) ──
# Ключ авторизации из кабинета developers.sber.ru → «Настройка API».
# Модели задаются теми же AI_MODEL и AI_MODEL_LIGHT, например
# GigaChat-2-Pro для сложных вопросов и GigaChat-2 для простых.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Сертификат Минцифры: без него TLS до Сбера не проверяется.
#   curl -o /etc/atmosfera/ru-ca.pem https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
# Отключать проверку сертификата (verify_ssl_certs=False из примеров Сбера) нельзя.
GIGACHAT_CA=/etc/atmosfera/ru-ca.pem

# ── Векторный поиск по каталогу (необязательно) ──
# Справку консультанту подбирает гибридный поиск: слова (BM25) всегда,
# векторы — если здесь задана модель эмбеддингов. Векторы записей считаются
# один раз и лежат в vectors.json рядом с базой знаний.
# У ключа GIGACHAT_API_PERS эмбеддинги платные: без пакета сервис отвечает
# 402, поиск молча остаётся словарным, консультант работает.
EMBEDDINGS_MODEL=
EMBEDDINGS_URL=https://api.giga.chat/v1/embeddings

# ── Пути (значения по умолчанию подходят для сервера) ──
DATA_DIR=/var/lib/atmosfera
SOCKET=/run/atmosfera/atmosfera.sock
SITE_DIR=/var/www/atmospheremeb.ru
