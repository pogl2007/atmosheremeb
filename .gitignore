node_modules/

# ── Секреты. В репозиторий не должны попасть никогда ──
# config.php — боевой токен Telegram, ключ ИИ и хеш пароля админки.
.env
public/config.php

# ── Персональные данные ──
# public/data/ — журнал заявок с именами и телефонами клиентов,
# промпт ИИ и служебные выгрузки. Всё остальное там создаёт сборка.
public/data/

# ── Исходники сборки ──
# 93 МБ оригиналов фотографий. В репозитории лежит обработанный
# результат в public/img, оригиналы хранятся отдельно.
data/*
!data/catalog.json

# ── Мусор ──
shots/
server.log
*.zip
*.tar.gz
/*.jpg
