node_modules/

# ── Секреты. В репозиторий не должны попасть никогда ──
# На сервере они живут в /etc/atmosfera/atmosfera.env с правами 600.
.env

# ── Данные работающего сайта ──
# Журнал заявок с телефонами клиентов, промпт ИИ и выгрузка каталога.
# Сборка создаёт их заново, на сервере они лежат в /var/lib/atmosfera.
build-data/

# ── Исходники сборки ──
# 93 МБ оригиналов фотографий. В репозитории лежит обработанный
# результат в public/img, оригиналы хранятся отдельно.
data/*
!data/catalog.json

# ── Мусор ──
shots/
server.log
*.zip
*.tar.gz
/*.jpg
